params {
    input = null
    clone_alignment_folder = null
    read_assignments = null
    min_unique_reads = 3
    min_family_fraction = 0.60
    outdir = 'results'
}

process.container = 'quay.io/jupyter/scipy-notebook:python-3.12'

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}
